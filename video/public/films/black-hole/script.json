        {
          "big": "30 min",
          "small": "default expiry"
        },
        {
          "big": "2",
          "small": "platforms: macOS + Android"
        }
      ],
      "vo": [
        {
          "id": "flow1",
          "text": "A shared Rust core holds the store, identities and expiry. The Mac app is a thin Tauri shell over it."
        },
        {
          "id": "flow2",
          "text": "The Android app speaks the same wire protocol in TypeScript, and it was proven against the real Rust CLI over actual sockets before it shipped."
        }
      ]
    },
