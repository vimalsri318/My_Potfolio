{
  "slug": "black-hole",
  "title": "Black Hole",
  "accent": "#E8590C",
  "scenes": [
    {
      "kind": "hook",
      "headline": "To get a link to your phone, you [message yourself.]",
      "strike": [
        "A chat with yourself",
        "A cloud clipboard that keeps everything"
      ],
      "punch": "Black Hole skips [the middleman.]",
      "vo": [
        {
          "id": "hook1",
          "text": "Moving a link or a screenshot from your laptop to your phone usually means messaging yourself, or trusting a cloud clipboard that keeps everything."
        },
        {
          "id": "hook2",
          "text": "Black Hole skips the middleman."
        }
      ]
    },
    {
      "kind": "intro",
      "title": "Black Hole",
      "tagline": "A private clipboard between your Mac and your phone. Throw in. Pull out. Anywhere.",
      "badge": "Open source · MIT",
      "logo": "films/black-hole/media/logo.png",
      "media": {
        "type": "stage",
        "slug": "black-hole"
      },
      "vo": [
        {
          "id": "intro1",
          "text": "Copy something on your Mac, and it's on your phone a second later, over your own Wi-Fi, with no account and no server."
        }
      ]
    },
    {
      "kind": "feature",
      "kicker": "Pair once",
      "headline": "A six-digit code, [then they just talk.]",
      "bullets": [
        "A code and a QR on the Mac, one scan on the phone",
        "Each device has an Ed25519 identity",
        "Found on the local network with mDNS"
      ],
      "media": {
        "type": "terminal",
        "title": "demo.sh — two devices, one machine (real output)",
        "lines": [
          {
            "text": "blackhole pair host --port 17420 --default",
            "kind": "cmd"
          },
          {
            "text": "Pairing code: 859486",
            "kind": "accent"
          },
          {
            "text": "Waiting up to 5 minutes for a connection...",
            "kind": "dim"
          },
          {
            "text": "blackhole pair join --addr 127.0.0.1:17420 --code 859486",
            "kind": "cmd"
          },
          {
            "text": "Paired with \"Demo Mac\" — device id dev_44d22283396dc6ae855a  [default]",
            "kind": "ok"
          }
        ]
      },
      "vo": [
        {
          "id": "pair1",
          "text": "Devices pair once, with a six-digit code and a QR scan. Each one has its own Ed25519 identity, and they find each other on the local network."
        }
      ]
    },
    {
      "kind": "feature",
      "kicker": "Expires everywhere",
      "headline": "Thirty minutes, then [gone from both devices.]",
      "bullets": [
        "Text, links and images move the same way",
        "A 30-minute default expiry, pin what you keep",
        "Copy on the Mac is automatic; sending from the phone is one tap"
      ],
      "flip": true,
      "media": {
        "type": "terminal",
        "title": "demo.sh — send, list, expire (real output)",
        "lines": [
          {
            "text": "blackhole send --text \"https://example.com/article\" --ttl 3",
            "kind": "cmd"
          },
          {
            "text": "Sending Link (27 bytes) to dev_44d22283396dc6ae855a at 127.0.0.1:17420...",
            "kind": "out"
          },
          {
            "text": "Delivered.",
            "kind": "ok"
          },
          {
            "text": "blackhole list",
            "kind": "cmd"
          },
          {
            "text": "01M42F3Q…  Link  0s ago  expires in 1s  https://example.com/article",
            "kind": "out"
          },
          {
            "text": "blackhole expire && blackhole list",
            "kind": "cmd"
          },
          {
            "text": "Reaped 1 expired object(s).",
            "kind": "accent"
          },
          {
            "text": "Black Hole is empty.",
            "kind": "ok"
          }
        ]
      },
      "vo": [
        {
          "id": "ttl1",
          "text": "Text, links and images all travel the same way, and everything expires after thirty minutes on both devices at once, unless you pin it."
        },
        {
          "id": "ttl2",
          "text": "Sending from the phone is one deliberate tap, because Android doesn't let apps read the clipboard in the background."
        }
      ]
    },
    {
      "kind": "flow",
      "kicker": "Under the hood",
      "headline": "One Rust core. [Every shell is thin.]",
      "packet": "link · 27 bytes",
      "nodes": [
        {
          "icon": "laptop",
          "title": "Mac app",
          "sub": "Tauri shell, clipboard watcher"
        },
        {
          "icon": "cpu",
